{
  "name": "commit-arcade",
  "version": "0.1.0",
  "description": "Play your GitHub contributions as tiny arcade games.",
  "type": "module",
  "private": true,
  "scripts": {
    "build:chrome": "node scripts/build-extension.mjs chrome",
    "build:firefox": "node scripts/build-extension.mjs firefox",
    "lint": "tsc --noEmit",
    "package:archives": "node scripts/package-extension.mjs all",
    "package:amo-source": "node scripts/package-amo-source.mjs",
    "package:chrome": "node scripts/package-extension.mjs chrome",
    "package:firefox": "node scripts/package-extension.mjs firefox",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:chrome": "node scripts/validate-extension-package.mjs chrome",
    "validate:firefox": "node scripts/validate-extension-package.mjs firefox",
    "validate:packages": "npm run validate:chrome && npm run validate:firefox"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "esbuild": "^0.24.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
